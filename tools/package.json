{
  "name": "purna-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --coverage",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "chart": "esbuild scripts/bench-chart.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.tmp/bench-chart.mjs && node .tmp/bench-chart.mjs",
    "sounds": "esbuild scripts/make-sounds.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.tmp/make-sounds.mjs && node .tmp/make-sounds.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "@vitest/coverage-v8": "2.1.8",
    "esbuild": "0.21.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
