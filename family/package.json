{
  "name": "purna-family",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "db:migrate:local": "wrangler d1 migrations apply purna --local",
    "db:migrate:remote": "wrangler d1 migrations apply purna --remote",
    "deploy": "vite build && wrangler d1 migrations apply purna --remote && wrangler deploy",
    "sample": "esbuild scripts/make-sample.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.tmp/make-sample.mjs && node .tmp/make-sample.mjs",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:e2e": "playwright test",
    "build": "vite build",
    "dev:web": "vite"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@cloudflare/vitest-plugin": "1.10.0",
    "@cloudflare/workers-types": "5.20261127.1",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.15.17",
    "@types/react": "18.3.32",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "25.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.6.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "wrangler": "4.169.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@radix-ui/react-collapsible": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.82.0",
    "motion": "14.14.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.1"
  }
}
