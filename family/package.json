{
  "name": "purna-family",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply purna --local",
    "db:migrate:remote": "wrangler d1 migrations apply purna --remote",
    "deploy": "wrangler d1 migrations apply purna --remote && wrangler deploy",
    "sample": "esbuild scripts/make-sample.ts --bundle --platform=node --format=esm --log-level=warning --outfile=.tmp/make-sample.mjs && node .tmp/make-sample.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.10.0",
    "@cloudflare/workers-types": "5.20261127.1",
    "typescript": "5.6.3",
    "vitest": "4.1.12",
    "wrangler": "4.169.0"
  }
}
