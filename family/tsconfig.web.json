{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "web/src/*"
      ]
    }
  },
  "include": [
    "web/src/**/*.ts",
    "web/src/**/*.tsx",
    "web-test/**/*.ts",
    "web-test/**/*.tsx"
  ]
}